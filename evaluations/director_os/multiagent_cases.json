[
  {
    "id": "multiagent-linkedin-post",
    "description": "Researcher synthesizes project evidence; writer formats it as a LinkedIn post with appropriate tone and structure.",
    "inputs": {
      "data_path": "data/local_only/projects",
      "focus": "leadership update",
      "max_documents": 5,
      "target_audience": "linkedin_post"
    },
    "reference_outputs": {
      "expected_audience": "linkedin_post",
      "required_content_signals": ["leadership", "team", "platform"],
      "must_not_contain": ["I cannot", "no context", "unable to"],
      "expected_min_agent_calls": 2,
      "expected_agent_names": ["researcher", "writer"]
    }
  },
  {
