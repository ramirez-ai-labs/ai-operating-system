# LangSmith — get a key at smith.langchain.com
LANGSMITH_API_KEY=lsv2_your_key_here
LANGSMITH_TRACING=false        # set to true to enable trace upload
LANGSMITH_PROJECT=ai-os

# Anthropic — get a key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Ollama (local default — change if Ollama runs on a different port or model)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Claude model selection — Haiku is the cost-effective default for synthesis
# Options: claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-8
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Retrieval backend
# local_files  — keyword scorer, no external deps, safe for CI (default)
# chroma       — ChromaDB semantic search; requires Ollama + nomic-embed-text
#                Run: ollama pull nomic-embed-text
#                     python scripts/ingest_local_data.py
RETRIEVAL_BACKEND=local_files

# ChromaDB telemetry — disable to suppress posthog errors in ChromaDB 0.6.x
ANONYMIZED_TELEMETRY=False
